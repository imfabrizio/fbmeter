# ─── Database (obbligatorio) ─────────────────────────────────────────────
# Qualsiasi PostgreSQL 14+: Neon, Azure Database for PostgreSQL, un server proprio…
# Su Neon usa la stringa "pooled" (host con -pooler) se l'app gira su Vercel.
DATABASE_URL=postgres://utente:password@host:5432/fbmeter?sslmode=require

# ─── Sicurezza (obbligatorie) ────────────────────────────────────────────
# Firma dei cookie di sessione. Genera con: openssl rand -base64 32
AUTH_SECRET=
# Cifratura delle chiavi AI degli operatori (min. 32 caratteri). Genera con: openssl rand -base64 48
# ATTENZIONE: se la cambi, le chiavi AI salvate non si leggono più e vanno reinserite.
APP_ENCRYPTION_KEY=

# ─── URL pubblico (consigliato) ──────────────────────────────────────────
# Usato per il QR code. Se vuoto viene ricavato dalla richiesta.
APP_URL=https://fbmeter.example.com

# ─── Chi può usare la regia ──────────────────────────────────────────────
# Sempre amministratori (separati da virgola)
ADMIN_EMAILS=nome@dominio.it
# Domini abilitati in automatico come operatori (facoltativo)
OPERATOR_EMAIL_DOMAINS=

# ─── Accesso con Microsoft Entra ID (facoltativo) ────────────────────────
# Redirect URI da registrare: https://<tuo-host>/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<TENANT_ID>/v2.0

# ─── Accesso con Google (facoltativo) ────────────────────────────────────
# Redirect URI da registrare: https://<tuo-host>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Solo sviluppo locale ────────────────────────────────────────────────
# Accesso con la sola email, senza password. MAI in produzione.
# AUTH_DEV_LOGIN_INSECURE=1

# Pagine /privacy e /termini: titolare e contatto (consigliati)
APP_OWNER_NAME=
APP_CONTACT_EMAIL=
# APP_LEGAL_UPDATED=3 novembre 2026

# Nome mostrato nel titolo della pagina (facoltativo)
# APP_NAME=FBMeter
